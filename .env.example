# Copy to .env and fill in real values. Never commit .env.
# This file must only ever contain placeholder values.

# Postgres (Supabase or Neon) — Evidence layer
DATABASE_URL=postgresql://user:password@host:5432/peos

# Google OAuth client (used only if/when direct API integration is built;
# V1 automation runtime uses claude.ai Workspace connectors instead — see docs/automation.md)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# GitHub — prefer `gh auth login` locally over a stored token.
# Only set this if a script truly needs non-interactive GitHub API access.
GITHUB_TOKEN=

# News/search provider, if a paid API is ever added (WebSearch is used by default)
NEWS_API_KEY=
